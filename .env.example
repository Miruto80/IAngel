# Copia este archivo a .env y completa las variables requeridas.
# La conversación actual con Qwen no requiere base de datos ni embeddings.

# Clave pública RS256 de Ángel; la privada queda únicamente en el servidor PHP
JWT_PUBLIC_KEY_PATH=****
# Chat directo con Qwen a través de Groq
GROQ_API_KEY=***
LLM_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT_SECONDS=30

# Dominio de la tienda (CORS)
CORS_ORIGINS=http://localhost,http://127.0.0.1,https://lovemakeup.com

# Opcionales: solo para reactivar el indexado/recomendación vectorial luego.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=angel
# DB_PASSWORD=cambia_esto
# DB_NAME=u417714339_Lovemakeupbd
# OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
