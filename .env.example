# Copia este archivo a .env y completa los valores
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=angel
DB_PASSWORD=cambia_esto
DB_NAME=u417714339_Lovemakeupbd

# Secreto COMPARTIDO con el backend PHP (el PHP firma el JWT, Python lo valida)
JWT_SECRET=cambia_este_secreto_largo_y_aleatorio
JWT_ALGORITHM=HS256

# Toda la IA pasa por OpenRouter: embeddings + redacción con un solo cliente
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embeddings: qwen3-embedding-0.6b devuelve 1024 dimensiones (EMBEDDING_DIM).
# Otros tamaños: qwen3-embedding-4b=2560, qwen3-embedding-8b=4096.
# Si cambias de modelo, ajusta EMBEDDING_DIM, recrea la columna VECTOR(N) y reindexa.
EMBEDDING_MODEL=qwen/qwen3-embedding-0.6b
EMBEDDING_DIM=1024

# Redacción de la respuesta de Ángel (modelo de chat, formato OpenAI)
LLM_MODEL=qwen/qwen3-30b-a3b:free
LLM_TIMEOUT_SECONDS=3.0

# Dominio de la tienda (CORS)
CORS_ORIGINS=http://localhost,http://127.0.0.1,https://lovemakeup.com
