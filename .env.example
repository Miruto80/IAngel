# Copia este archivo a .env y completa los valores
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=angel
DB_PASSWORD=cambia_esto
DB_NAME=u417714339_Lovemakeupbd

# El backend PHP firma el JWT con RS256 (Lovemakeup-3.0/config/jwt_private.pem)
# y este servicio solo verifica con la llave pública de ese mismo par.
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY=ai_public.pem
# Modo legado HS256 (secreto compartido con hash_hmac en el PHP viejo):
# JWT_ALGORITHM=HS256
# JWT_SECRET=el_mismo_secreto_del_php

# Toda la IA pasa por OpenRouter: embeddings + redacción con un solo cliente
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embeddings: baai/bge-m3 devuelve 1024 dimensiones nativas (EMBEDDING_DIM),
# igual que la columna VECTOR(1024): el modelo ya está alineado con el esquema.
# Si cambias a otro modelo, ajusta EMBEDDING_DIM, recrea la columna y reindexa.
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_DIM=1024

# Redacción de la respuesta de Ángel: modelo de chat pago multimodal
# (texto y fotos; las fotos se describen con este mismo modelo).
LLM_MODEL=qwen/qwen3-vl-30b-a3b-instruct
LLM_TIMEOUT_SECONDS=6.0
VISION_TIMEOUT_SECONDS=15.0
MAX_IMAGENES=3

# Dominio de la tienda (CORS)
CORS_ORIGINS=http://localhost,http://127.0.0.1,https://lovemakeup.com
